{
  "expo": {
    "name": "Book Spines OCR",
    "slug": "book-spines-ocr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Book Spines OCR needs the camera to photograph your bookshelf.",
        "NSPhotoLibraryUsageDescription": "Book Spines OCR needs photo library access to pick a bookshelf photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Book Spines OCR to pick a bookshelf photo.",
          "cameraPermission": "Allow Book Spines OCR to photograph your bookshelf."
        }
      ]
    ]
  }
}
