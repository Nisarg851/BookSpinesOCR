# Repo-root secrets (gitignored). Copy to .env and fill in.
# Used by backend — never commit real keys.

# Default: OpenAI vision (fast). Cursor is used automatically if OpenAI fails.
# Force Cursor only with: VLM_PROVIDER=cursor
VLM_PROVIDER=openai
VLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
CURSOR_API_KEY=
